# Copy this file to .env and adjust the values for your machine.

# PostgreSQL
DB_NAME=javora
DB_USERNAME=javora
DB_PASSWORD=javora
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/javora

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (S3 compatible storage)
MINIO_ROOT_USER=javora
MINIO_ROOT_PASSWORD=javora-secret

# Mail (Mailpit in development)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
